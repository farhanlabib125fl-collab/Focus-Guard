{
  "name": "focus-guard",
  "version": "1.0.0",
  "description": "Focus and Distraction Blocker",
  "main": "main.js",
  "author": "Focus Guard",
  "scripts": {
    "prep": "node tools/prepare-assets.js",
    "start": "npm run prep && node tools/set-dev-icon.js && npx electron main.js",
    "pack": "npm run prep && electron-builder --win --dir",
    "build": "npm run prep && electron-builder --win",
    "devicon": "node tools/set-dev-icon.js"
  },
  "keywords": [],
  "license": "ISC",
  "devDependencies": {
    "@fontsource/baloo-da-2": "^5.0.0",
    "electron": "^44.7.0",
    "electron-builder": "^25.1.8",
    "rcedit": "^5.0.2"
  },
  "build": {
    "appId": "com.focusguard.app",
    "productName": "Focus Guard",
    "afterPack": "tools/after-pack.js",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "extraResources": ["focusguard.ico"],
    "files": [
      "main.js",
      "guardian.js",
      "preload.js",
      "index.html",
      "package.json",
      "fonts/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "focusguard.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "focusguard.ico",
      "uninstallerIcon": "focusguard.ico",
      "shortcutName": "Focus Guard",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  }
}